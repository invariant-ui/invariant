{
  "title": "Invariant evidence file v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "evidenceVersion": {
      "type": "string",
      "const": "1.0.0"
    },
    "contractContentHash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^ev_[0-9a-f]{24}$"
          },
          "sourceId": {
            "type": "string",
            "maxLength": 64,
            "pattern": "^[a-z0-9][a-z0-9._-]*$"
          },
          "sourceRef": {
            "type": "string",
            "minLength": 1
          },
          "location": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "const": "file"
                  },
                  "path": {
                    "type": "string",
                    "minLength": 1
                  },
                  "line": {
                    "type": "integer",
                    "exclusiveMinimum": 0,
                    "maximum": 9007199254740991
                  },
                  "column": {
                    "type": "integer",
                    "exclusiveMinimum": 0,
                    "maximum": 9007199254740991
                  },
                  "endLine": {
                    "type": "integer",
                    "exclusiveMinimum": 0,
                    "maximum": 9007199254740991
                  },
                  "endColumn": {
                    "type": "integer",
                    "exclusiveMinimum": 0,
                    "maximum": 9007199254740991
                  }
                },
                "required": [
                  "type",
                  "path"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "const": "document"
                  },
                  "documentId": {
                    "type": "string",
                    "minLength": 1
                  },
                  "title": {
                    "type": "string",
                    "minLength": 1
                  },
                  "section": {
                    "type": "string",
                    "minLength": 1
                  },
                  "url": {
                    "type": "string",
                    "format": "uri"
                  }
                },
                "required": [
                  "type",
                  "documentId"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "const": "url"
                  },
                  "url": {
                    "type": "string",
                    "format": "uri"
                  },
                  "pointer": {
                    "type": "string"
                  }
                },
                "required": [
                  "type",
                  "url"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "const": "design-node"
                  },
                  "fileKey": {
                    "type": "string",
                    "minLength": 1
                  },
                  "nodeId": {
                    "type": "string",
                    "minLength": 1
                  },
                  "variableKey": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "type",
                  "fileKey"
                ],
                "additionalProperties": false
              }
            ]
          },
          "method": {
            "type": "string",
            "enum": [
              "ast",
              "compiler-api",
              "metadata-parse",
              "structured-parse",
              "document-parse",
              "llm-assisted",
              "manual"
            ]
          },
          "extractor": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "version": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "name",
              "version"
            ],
            "additionalProperties": false
          },
          "original": {
            "type": "string",
            "maxLength": 2000
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "verificationStatus": {
            "type": "string",
            "enum": [
              "unverified",
              "verified",
              "contradicted"
            ]
          },
          "capturedAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
          }
        },
        "required": [
          "id",
          "sourceId",
          "sourceRef",
          "location",
          "method",
          "extractor",
          "verificationStatus",
          "capturedAt"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "evidenceVersion",
    "contractContentHash",
    "evidence"
  ],
  "additionalProperties": false
}
