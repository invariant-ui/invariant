# Records the README demo. Needs https://github.com/charmbracelet/vhs (brew install vhs).
#   pnpm build && vhs docs/demo/demo.tape
# Output: docs/demo/enforcement-loop.gif
Output docs/demo/enforcement-loop.gif
Set Shell "bash"
Set FontSize 14
Set Width 1200
Set Height 760
Set TypingSpeed 40ms
Type "pnpm demo"
Enter
Sleep 25s
