      "behavior": {
        "initial": "idle",
        "states": [
          {
            "name": "idle"
          },
          {
            "feedback": "Name what will be deleted and offer Cancel.",
            "name": "confirming",
            "verifiableBy": "static"
          },
          {
            "feedback": "Show progress.",
            "name": "deleting",
            "verifiableBy": "runtime"
          },
          {
            "feedback": "Confirm the result.",
            "name": "done",
            "terminal": true
          },
          {
            "feedback": "Explain the failure and allow a retry.",
            "name": "failed"
          }
        ],
        "transitions": [
          {
            "from": "idle",
            "id": "ask",
            "to": "confirming",
            "trigger": "user chooses Delete"
          },
          {
            "from": "confirming",
            "id": "cancel",
            "to": "idle"
          },
          {
            "from": "confirming",
            "id": "confirm",
            "to": "deleting"
          },
          {
            "from": "deleting",
            "id": "succeed",
            "to": "done"
          },
          {
            "from": "deleting",
            "id": "fail",
            "to": "failed"
          },
          {
            "from": "failed",
            "id": "retry",
            "to": "deleting"
          },
          {
            "from": "failed",
            "id": "dismiss",
            "to": "idle"
          }
        ]
      },
